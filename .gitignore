# 비밀 정보 - 절대 깃허브에 올라가면 안 되는 파일
.env
.streamlit/secrets.toml

# 파이썬이 자동으로 만드는 임시 파일
__pycache__/
*.py[cod]
*.egg-info/

# 가상환경 폴더 (부품 라이브러리가 설치되는 곳, 용량이 큼)
.venv/
venv/
env/

# 운영체제가 만드는 잡파일
.DS_Store
Thumbs.db
desktop.ini

# 로그/임시 결과물
*.log
.cache/

# 전달용으로 만든 압축 파일은 저장소에 넣지 않습니다
*.zip
*.patch

# 웹 화면(Next.js)이 자동으로 만드는 것들
web/node_modules/
web/.next/
# 웹을 web 폴더 밖에서 실수로 빌드하면 여기에 생깁니다
.next/
web/out/
web/.vercel/
web/.env*.local
web/tsconfig.tsbuildinfo
web/next-env.d.ts
