# =============================================================
#  .env 견본 파일  —  비밀 정보 보관함
# =============================================================
# 사용법
#   1) 이 파일을 복사해서 이름을 ".env" 로 바꾸세요.
#         (윈도우 명령어)  copy .env.example .env
#   2) 아래 세 줄의 = 뒤에 각자의 실제 값을 붙여넣으세요.
#   3) 저장하면 끝입니다.
#
#  .env 파일은 .gitignore 에 등록되어 있어 깃허브에 절대 올라가지 않습니다.
#
# 주의사항
#   - 따옴표(" ")로 감싸지 마세요.
#   - = 앞뒤에 공백을 넣지 마세요.
#   - 값은 한 줄로 붙여넣으세요 (중간에 줄바꿈이 들어가면 안 됩니다).
# =============================================================


# ─────────────────────────────────────────────────────────────
# 1) Neon 데이터베이스 연결 문자열
# ─────────────────────────────────────────────────────────────
#    어디서 구하나요?
#      Neon 웹사이트 로그인 > 내 프로젝트 선택 > Dashboard 화면의
#      "Connection string" 상자에서 복사 버튼을 누르면 됩니다.
#      postgresql:// 로 시작하는 긴 한 줄입니다.
#
#    아래는 가짜 예시입니다. 반드시 본인 값으로 바꾸세요.
DATABASE_URL=postgresql://myuser:mypassword@ep-cool-name-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require


# ─────────────────────────────────────────────────────────────
# 2) 한국거래소(KRX) 정보데이터시스템 로그인 정보
# ─────────────────────────────────────────────────────────────
#    왜 필요한가요?
#      2025년 이후 한국거래소가 정책을 바꿔서, 시세 데이터를 받으려면
#      회원 로그인이 필요해졌습니다. 회원가입은 무료입니다.
#
#    어떻게 만드나요?
#      https://data.krx.co.kr  접속 > 우측 상단 [로그인] > [회원가입]
#      이메일 인증까지 마치면 됩니다.
#
#    아래에 그 아이디와 비밀번호를 적으세요.
KRX_ID=your_krx_id
KRX_PW=your_krx_password


# ─────────────────────────────────────────────────────────────
# 3) (선택) 수집 속도 조절 — 그냥 두셔도 됩니다
# ─────────────────────────────────────────────────────────────
# 요청과 요청 사이에 쉬는 시간(초). 숫자를 키우면 느리지만 더 안전합니다.
REQUEST_DELAY_SEC=0.6
# 실패했을 때 다시 시도하는 최대 횟수
MAX_RETRY=4
